<!DOCTYPE html>
<html>
<head>
  <title>Settings | OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <div class="page-header">
      <div>
        <h1 style="margin:0;">Clinic Settings</h1>
      </div>
    </div>

    <div class="card" style="max-width:560px;">
      <h2 style="margin-top:0; color:#0B3D2E;">Consultation Fee Configuration</h2>
      <form action="/settings" method="POST">
        <div class="form-group" style="margin-bottom:20px;">
          <label style="font-size:13px; font-weight:600; display:block; margin-bottom:6px;">
            Standard Consultation Fee (GHS)
          </label>
          <div style="display:flex; gap:12px; align-items:center;">
            <input
              type="number"
              name="consultation_fee"
              value="<%= consultationFee %>"
              step="0.01"
              min="0"
              style="max-width:200px; font-size:1.1rem; font-weight:700;"
              required
            />
            <button type="submit" class="btn">Save Setting</button>
          </div>
        </div>
      </form>
      <div style="margin-top:16px; padding:12px 16px; background:#EAF5EF; border-radius:10px; font-size:13.5px;">
        <strong>Current fee:</strong> GHS <%= parseFloat(consultationFee).toFixed(2) %> per consultation
      </div>
    </div>

  </div>
</div>
</body>
</html>
