<!DOCTYPE html>
<html>
<head>
  <title>Clinic Settings &amp; Branding | OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2220%22 fill=%22%230B3D2E%22/><text x=%2250%22 y=%2265%22 font-size=%2255%22 fill=%22white%22 text-anchor=%22middle%22 font-family=%22Arial%22>O</text></svg>" />
  <style>
    .settings-grid {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      gap: 24px;
      align-items: start;
    }
    .logo-preview-box {
      width: 140px;
      height: 140px;
      border: 2px dashed #CBD5E1;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #F8FAFC;
      overflow: hidden;
      margin-bottom: 12px;
    }
    .logo-preview-box img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
  </style>
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    
    <!-- Top Header -->
    <div class="page-header" style="margin-bottom:20px;">
      <div>
        <h1 style="margin:0 0 4px; color:#0B3D2E;">Clinic Settings &amp; Custom Letterhead</h1>
        <div style="font-size:13px; color:#64748B;">
          Configure practice logo, official letterhead, consultation pricing, and staff login access.
        </div>
      </div>
      <a href="/dashboard" class="btn btn-secondary">&larr; Dashboard</a>
    </div>

    <!-- Success Alert -->
    <script>
      if (window.location.search.includes('saved=1')) {
        document.write('<div style="background:#F0FDF4; border:1px solid #BBF7D0; border-left:4px solid #166534; padding:12px 16px; border-radius:8px; margin-bottom:20px; font-weight:700; color:#166534;">Settings &amp; Letterhead saved successfully.</div>');
      }
    </script>

    <div class="settings-grid">
      
      <!-- LEFT COLUMN: BRANDING & LETTERHEAD -->
      <div style="display:flex; flex-direction:column; gap:24px;">
        
        <!-- Clinic Logo Uploader Card -->
        <div class="card" style="border-left:4px solid #166534;">
          <h2 style="margin-top:0; color:#0B3D2E; font-size:1.15rem; margin-bottom:6px;">1. Clinic Logo (Official Letterhead)</h2>
          <div style="font-size:12.5px; color:#64748B; margin-bottom:16px;">
            Upload your clinic's logo image (.png, .jpg, .svg). It will automatically appear as the official header on all <strong>Patient Invoices</strong>, <strong>Optical Prescriptions</strong>, <strong>Medical Referral Letters</strong>, and <strong>Financial Reports</strong>.
          </div>

          <div style="display:flex; gap:20px; align-items:center; flex-wrap:wrap;">
            <div class="logo-preview-box">
              <% if (typeof clinicSettings !== 'undefined' && clinicSettings.clinic_logo) { %>
                <img src="/uploads/<%= clinicSettings.clinic_logo %>" alt="Current Clinic Logo" />
              <% } else { %>
                <div style="text-align:center; color:#94A3B8; font-size:11px; padding:10px;">
                  <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#CBD5E1" stroke-width="1.5" style="margin:0 auto 4px; display:block;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  No Logo Uploaded
                </div>
              <% } %>
            </div>

            <form action="/settings/logo" method="POST" enctype="multipart/form-data" style="flex:1; min-width:200px;">
              <label style="font-size:12px; font-weight:600; display:block; margin-bottom:6px;">Select New Logo Image File:</label>
              <input type="file" name="logo" accept="image/*" required style="font-size:12px; margin-bottom:10px;" />
              <button type="submit" class="btn btn-sm" style="background:#166534; font-weight:700; padding:8px 16px;">
                Upload &amp; Set Logo
              </button>
            </form>
          </div>
        </div>

        <!-- Clinic Details & Contact Letterhead Form -->
        <div class="card">
          <h2 style="margin-top:0; color:#0B3D2E; font-size:1.15rem; margin-bottom:14px;">2. Practice Information &amp; Official Letterhead</h2>
          
          <form action="/settings" method="POST">
            <div class="form-group" style="margin-bottom:12px;">
              <label style="font-size:12px; font-weight:600;">Official Clinic / Hospital Name</label>
              <input type="text" name="clinic_name" value="<%= (typeof clinicSettings !== 'undefined' && clinicSettings.clinic_name) ? clinicSettings.clinic_name : 'OptiCare Eye Clinic' %>" required />
            </div>

            <div class="form-group" style="margin-bottom:12px;">
              <label style="font-size:12px; font-weight:600;">Clinic Tagline / Department Subtitle</label>
              <input type="text" name="clinic_tagline" value="<%= (typeof clinicSettings !== 'undefined' && clinicSettings.clinic_tagline) ? clinicSettings.clinic_tagline : 'Comprehensive Eyecare & Optical Diagnostic Centre' %>" placeholder="e.g. Comprehensive Eyecare & Optical Diagnostic Centre" />
            </div>

            <div class="grid-2" style="margin-bottom:12px;">
              <div class="form-group">
                <label style="font-size:12px; font-weight:600;">Clinic Phone / Hotline</label>
                <input type="text" name="clinic_phone" value="<%= (typeof clinicSettings !== 'undefined' && clinicSettings.clinic_phone) ? clinicSettings.clinic_phone : '+233 (0) 55 000 1234' %>" />
              </div>
              <div class="form-group">
                <label style="font-size:12px; font-weight:600;">Official Email Address</label>
                <input type="email" name="clinic_email" value="<%= (typeof clinicSettings !== 'undefined' && clinicSettings.clinic_email) ? clinicSettings.clinic_email : 'info@opticare.local' %>" />
              </div>
            </div>

            <div class="form-group" style="margin-bottom:12px;">
              <label style="font-size:12px; font-weight:600;">Physical Clinic Address / Location</label>
              <input type="text" name="clinic_address" value="<%= (typeof clinicSettings !== 'undefined' && clinicSettings.clinic_address) ? clinicSettings.clinic_address : 'Plot 14, Independence Avenue, Airport Residential Area, Accra, Ghana' %>" />
            </div>

            <div class="form-group" style="margin-bottom:18px;">
              <label style="font-size:12px; font-weight:600;">MOH / Regulatory Practice License Number</label>
              <input type="text" name="clinic_reg_number" value="<%= (typeof clinicSettings !== 'undefined' && clinicSettings.clinic_reg_number) ? clinicSettings.clinic_reg_number : 'MOH/GHS/OPT-2026-889' %>" placeholder="e.g. MOH/GHS/OPT-2026-889" />
            </div>

            <button type="submit" class="btn" style="background:#166534; font-weight:700; padding:10px 24px;">
              Save Practice Letterhead
            </button>
          </form>
        </div>

      </div>

      <!-- RIGHT COLUMN: PRICING & STAFF MANAGEMENT -->
      <div style="display:flex; flex-direction:column; gap:24px;">
        
        <!-- Consultation Fee Configuration -->
        <div class="card" style="border-left:4px solid #B45309;">
          <h2 style="margin-top:0; color:#0B3D2E; font-size:1.15rem; margin-bottom:6px;">3. Consultation Fee Rate</h2>
          <div style="font-size:12.5px; color:#64748B; margin-bottom:14px;">
            Sets the constant baseline fee automatically loaded onto patient visit invoices upon clinical intake.
          </div>

          <form action="/settings" method="POST">
            <div class="form-group" style="margin-bottom:14px;">
              <label style="font-size:12px; font-weight:600;">Standard Optometric Consultation Fee (GHS)</label>
              <div style="display:flex; gap:10px; align-items:center;">
                <input type="number" name="consultation_fee" value="<%= consultationFee %>" step="0.01" min="0" required style="font-size:1.15rem; font-weight:800; color:#0B3D2E; max-width:180px;" />
                <button type="submit" class="btn btn-sm" style="padding:10px 16px; font-weight:700;">Update Fee</button>
              </div>
            </div>
          </form>

          <div style="background:#FEF3C7; color:#92400E; padding:10px 14px; border-radius:8px; font-size:12px; font-weight:600;">
            Current Active Consultation Rate: GHS <%= parseFloat(consultationFee).toFixed(2) %>
          </div>
        </div>

        <!-- Staff & Doctor Logins Section in Settings -->
        <div class="card">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <div>
              <h2 style="margin:0; color:#0B3D2E; font-size:1.15rem;">4. Staff &amp; Doctor Logins</h2>
              <div style="font-size:12px; color:#64748B; margin-top:2px;">Manage clinic staff accounts and consulting room assignments.</div>
            </div>
            <a href="/staff" class="btn btn-sm" style="background:#166534; font-weight:700;">+ Manage Staff (/staff)</a>
          </div>

          <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:12.5px;">
              <thead>
                <tr style="background:#F8FAFC; border-bottom:1px solid #CBD5E1;">
                  <th style="padding:8px 10px; text-align:left; color:#475569;">Staff Member</th>
                  <th style="padding:8px 10px; text-align:left; color:#475569;">Role</th>
                  <th style="padding:8px 10px; text-align:left; color:#475569;">Room</th>
                </tr>
              </thead>
              <tbody>
                <% (users || []).forEach(function(u) { %>
                  <tr style="border-bottom:1px solid #F1F5F9;">
                    <td style="padding:8px 10px;">
                      <strong><%= u.name || u.email %></strong>
                      <div style="font-size:11px; color:#64748B;"><%= u.email %></div>
                    </td>
                    <td style="padding:8px 10px;">
                      <span class="badge badge-<%= u.role === 'doctor' ? 'success' : (u.role === 'admin' ? 'warning' : 'primary') %>" style="font-size:10px; text-transform:uppercase;">
                        <%= u.role %>
                      </span>
                    </td>
                    <td style="padding:8px 10px; color:#475569; font-weight:600;">
                      <%= u.room || 'General' %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <div style="margin-top:14px; text-align:right;">
            <a href="/staff" style="font-size:12px; font-weight:700; color:#166534; text-decoration:underline;">
              Open Full Staff Management Portal &rarr;
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</div>
</body>
</html>
