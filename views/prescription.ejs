<!DOCTYPE html>
<html>
<head>
  <title>Prescription · OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body style="padding:40px;">
  <div class="card" style="max-width:400px;">
    <h2 style="margin-top:0; color:var(--forest);">OptiCare Clinic</h2>
    <p><strong>Patient:</strong> <%= exam.full_name %></p>
    <p><strong>Date:</strong> <%= exam.exam_date %></p>
    <hr />
    <p><strong>Right Eye:</strong> <%= exam.visual_acuity_right %></p>
    <p><strong>Left Eye:</strong> <%= exam.visual_acuity_left %></p>
    <p><strong>Diagnosis:</strong> <%= exam.diagnosis %></p>
    <button class="btn" onclick="window.print()" style="margin-top:16px;">Print</button>
  </div>
</body>
</html>