<!DOCTYPE html>
<html>
<head>
  <title>Inventory · OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <div class="page-header">
      <h1>Inventory</h1>
      <div class="subtitle">Frames, lens solution, glasses cases, and drugs</div>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">Add Stock Item</h2>
      <form action="/inventory" method="POST" class="form-row">
        <div class="form-group"><input type="text" name="name" placeholder="Item name" required /></div>
        <div class="form-group">
          <select name="category" required>
            <option value="frame">Frame</option>
            <option value="lens_solution">Lens Solution</option>
            <option value="glasses_case">Glasses Case</option>
            <option value="drug">Drug</option>
          </select>
        </div>
        <div class="form-group"><input type="number" name="quantity" placeholder="Quantity" value="0" /></div>
        <div class="form-group"><input type="number" name="unit_price" step="0.01" placeholder="Unit price (GHS)" value="0" /></div>
        <button type="submit" class="btn">Add Item</button>
      </form>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">Current Stock</h2>
      <% if (items.length === 0) { %>
        <div class="empty-state">No stock items yet.</div>
      <% } else { %>
        <% items.forEach(function(item) { %>
          <div class="list-row">
            <div>
              <div class="name"><%= item.name %></div>
              <div class="meta"><%= item.category %> · GHS <%= item.unit_price %> each</div>
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
              <span class="badge <%= item.quantity <= 3 ? 'badge-danger' : 'badge-muted' %>"><%= item.quantity %> in stock</span>
              <form action="/inventory/<%= item.id %>/adjust" method="POST" class="inline">
                <input type="hidden" name="delta" value="1" />
                <button type="submit" class="btn btn-sm btn-secondary">+1</button>
              </form>
              <form action="/inventory/<%= item.id %>/adjust" method="POST" class="inline">
                <input type="hidden" name="delta" value="-1" />
                <button type="submit" class="btn btn-sm btn-secondary">-1</button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <a href="/">&larr; Back to patient list</a>
  </div>
</div>
</body>
</html>