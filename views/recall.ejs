<!DOCTYPE html>
<html>
<head>
  <title>Recall List | OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <div class="page-header">
      <div>
        <h1 style="margin:0;">Recall List</h1>
      </div>
      <a href="/" class="btn btn-secondary">&larr; Patient List</a>
    </div>

    <div class="card">
      <% if (overduePatients.length === 0) { %>
        <div class="empty-state">No overdue patients right now.</div>
      <% } else { %>
        <form action="/recall/send" method="POST">
          <% overduePatients.forEach(function(p) { %>
            <div class="list-row">
              <div>
                <label>
                  <input type="checkbox" name="patient_ids" value="<%= p.id %>" />
                  <span class="name"><%= p.full_name %></span>
                </label>
                <div class="meta">Last visit: <%= p.last_visit || 'Never' %></div>
              </div>
            </div>
          <% }); %>
          <button type="submit" class="btn" style="margin-top:16px;">Send Reminders to Selected</button>
        </form>
      <% } %>
    </div>

    <a href="/">&larr; Back to patient list</a>
  </div>
</div>
</body>
</html>