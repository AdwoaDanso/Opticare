<!DOCTYPE html>
<html>
<head>
  <title>Hospital Bill | <%= patient.full_name %> | OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    @media print {
      body { background: #fff; padding: 0; }
      .no-print { display: none !important; }
      .invoice-box { box-shadow: none; border: none; padding: 0; max-width: 100%; margin: 0; }
    }
    .invoice-box {
      max-width: 800px;
      margin: 20px auto;
      padding: 36px;
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
      font-size: 14px;
      line-height: 1.5;
    }
    .header-table { width: 100%; margin-bottom: 24px; border-bottom: 2px solid #0B3D2E; padding-bottom: 16px; }
    .header-table td { vertical-align: top; }
    .brand-title { font-size: 24px; font-weight: 800; color: #0B3D2E; margin: 0; }
    .brand-subtitle { font-size: 12px; color: #6B7280; margin-top: 4px; }
    .bill-meta { text-align: right; }
    .bill-meta h3 { margin: 0; font-size: 18px; color: #145C43; }
    
    .patient-info-box {
      background: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
    }
    
    .category-heading {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #0B3D2E;
      background: #EAF5EF;
      padding: 8px 12px;
      border-radius: 6px;
      margin: 16px 0 8px 0;
    }
    
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
    }
    .items-table th {
      text-align: left;
      padding: 8px 12px;
      background: #F1F5F9;
      font-size: 12px;
      color: #475569;
      border-bottom: 1px solid #CBD5E1;
    }
    .items-table td {
      padding: 10px 12px;
      border-bottom: 1px solid #F1F5F9;
    }
    
    .summary-card {
      margin-top: 24px;
      margin-left: auto;
      width: 320px;
      border: 1px solid #E2E8F0;
      border-radius: 8px;
      overflow: hidden;
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 16px;
      border-bottom: 1px solid #F1F5F9;
    }
    .summary-row.grand-total {
      background: #0B3D2E;
      color: #fff;
      font-size: 16px;
      font-weight: 700;
      border: none;
    }
    .footer-note {
      text-align: center;
      margin-top: 36px;
      padding-top: 16px;
      border-top: 1px solid #E2E8F0;
      font-size: 12px;
      color: #94A3B8;
    }
  </style>
</head>
<body style="background: #F0F1EC; padding: 20px;">

<div class="invoice-box">
  <div id="paymentAlert" class="no-print" style="display:none; background:#F0FDF4; border:1px solid #BBF7D0; border-left:4px solid #166534; border-radius:8px; padding:12px 16px; margin-bottom:16px; align-items:center; justify-content:space-between;">
    <div style="display:flex; align-items:center; gap:8px; color:#166534; font-size:13.5px; font-weight:700;">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#166534" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
      Payment Received &amp; Recorded Successfully. Click &ldquo;Print Official Bill&rdquo; below.
    </div>
  </div>

  <div class="no-print" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
    <a href="/patients/<%= patient.id %>" class="btn btn-secondary" style="display:inline-flex; align-items:center; gap:6px;">
      <svg class="svg-icon sm" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      Back to Patient Chart
    </a>
    <button class="btn" onclick="window.print()" style="display:inline-flex; align-items:center; gap:6px; font-weight:700; padding:10px 20px;">
      <svg class="svg-icon sm" viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      Print Official Bill
    </button>
  </div>

  <script>
    if (window.location.search.includes('paid=1')) {
      const alertEl = document.getElementById('paymentAlert');
      if (alertEl) alertEl.style.display = 'flex';
    }
  </script>

  <table class="header-table">
    <tr>
      <td>
        <div class="brand-title">OptiCare Eye Clinic</div>
        <div class="brand-subtitle">Comprehensive Eyecare & Diagnostic Center · Accra, Ghana</div>
        <div class="brand-subtitle">Tel: +233 (0) 55 000 1234 · info@opticare.local</div>
      </td>
      <td class="bill-meta">
        <h3>HOSPITAL INVOICE / RECEIPT</h3>
        <div><strong>Date:</strong> <%= date %></div>
        <div><strong>Bill Ref:</strong> OPT-<%= patient.id %>-<%= new Date().getFullYear() %></div>
      </td>
    </tr>
  </table>

  <div class="patient-info-box">
    <div>
      <div><strong>Patient Name:</strong> <%= patient.full_name %></div>
      <div><strong>Patient ID:</strong> #<%= patient.id %></div>
      <div><strong>Phone:</strong> <%= patient.phone || 'N/A' %></div>
    </div>
    <div style="text-align: right;">
      <div><strong>Payment Status:</strong> 
        <% if (totalUnpaid === 0 && grandTotal > 0) { %>
          <span style="color: #15803D; font-weight: bold;">PAID IN FULL</span>
        <% } else if (totalPaid > 0) { %>
          <span style="color: #B45309; font-weight: bold;">PARTIALLY PAID</span>
        <% } else { %>
          <span style="color: #B91C1C; font-weight: bold;">UNPAID / PENDING</span>
        <% } %>
      </div>
      <div><strong>Payment Date:</strong> <%= date %></div>
    </div>
  </div>

  <% if (invoices.length === 0) { %>
    <div style="text-align: center; padding: 40px; color: #64748B;">No charges or line items logged for this patient yet.</div>
  <% } else { %>
    <% 
      const grouped = {};
      invoices.forEach(inv => {
        const cat = inv.category || 'Consultation & Examination';
        if (!grouped[cat]) grouped[cat] = [];
        grouped[cat].push(inv);
      });
    %>

    <% Object.keys(grouped).forEach(cat => { %>
      <div class="category-heading"><%= cat %></div>
      <table class="items-table">
        <thead>
          <tr>
            <th>Item / Service Description</th>
            <th style="text-align:center; width:60px;">Qty</th>
            <th style="text-align:right; width:100px;">Unit Price</th>
            <th style="text-align:right; width:100px;">Discount</th>
            <th style="text-align:right; width:100px;">Line Total</th>
            <th style="text-align:center; width:80px;">Status</th>
          </tr>
        </thead>
        <tbody>
          <% grouped[cat].forEach(item => { %>
            <tr>
              <td>
                <div style="font-weight:600;"><%= item.description %></div>
              </td>
              <td style="text-align:center;"><%= item.quantity || 1 %></td>
              <td style="text-align:right;">GHS <%= (item.unit_price || item.amount).toFixed(2) %></td>
              <td style="text-align:right;"><%= item.discount ? 'GHS ' + Number(item.discount).toFixed(2) : '0.00' %></td>
              <td style="text-align:right; font-weight:700;">GHS <%= Number(item.amount).toFixed(2) %></td>
              <td style="text-align:center;">
                <span class="badge <%= item.status === 'paid' ? 'badge-success' : 'badge-danger' %>" style="font-size:10px;">
                  <%= item.status.toUpperCase() %>
                </span>
              </td>
            </tr>
          <% }); %>
          <tr style="background:#F8FAFC;">
            <td colspan="4" style="text-align:right; font-weight:600; color:#475569;">Subtotal (<%= cat %>):</td>
            <td style="text-align:right; font-weight:700; color:#0B3D2E;">GHS <%= (categoryTotals[cat] || 0).toFixed(2) %></td>
            <td></td>
          </tr>
        </tbody>
      </table>
    <% }); %>

    <div class="summary-card">
      <div class="summary-row">
        <span>Total Bill (Gross)</span>
        <strong>GHS <%= grandTotal.toFixed(2) %></strong>
      </div>
      <div class="summary-row" style="color: #15803D;">
        <span>Amount Paid</span>
        <strong>GHS <%= totalPaid.toFixed(2) %></strong>
      </div>
      <div class="summary-row" style="color: #B91C1C;">
        <span>Balance Due</span>
        <strong>GHS <%= totalUnpaid.toFixed(2) %></strong>
      </div>
      <div class="summary-row grand-total">
        <span>Grand Total</span>
        <span>GHS <%= grandTotal.toFixed(2) %></span>
      </div>
    </div>
  <% } %>

  <div class="footer-note">
    Thank you for choosing OptiCare Eye Clinic. Keep this receipt for your optical warranty and insurance claims.
  </div>
</div>

</body>
</html>
