<!DOCTYPE html>
<html>
<head>
  <title>Staff &amp; Login Management | OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2220%22 fill=%22%230B3D2E%22/><text x=%2250%22 y=%2265%22 font-size=%2255%22 fill=%22white%22 text-anchor=%22middle%22 font-family=%22Arial%22>O</text></svg>" />
  <style>
    .staff-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13.5px;
    }
    .staff-table th {
      background: #F8FAFC;
      padding: 10px 14px;
      text-align: left;
      color: #475569;
      border-bottom: 2px solid #CBD5E1;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .staff-table td {
      padding: 12px 14px;
      border-bottom: 1px solid #E2E8F0;
      vertical-align: middle;
    }
    .role-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }
    .role-admin { background: #FEF3C7; color: #92400E; }
    .role-doctor { background: #EAF5EF; color: #0B3D2E; }
    .role-receptionist { background: #EFF6FF; color: #1D4ED8; }
  </style>
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    
    <!-- Top Header -->
    <div class="page-header" style="margin-bottom:20px;">
      <div>
        <h1 style="margin:0 0 4px; color:#0B3D2E;">Staff &amp; Login Management</h1>
        <div style="font-size:13px; color:#64748B;">
          Provision doctor credentials, assign consulting rooms, and manage clinic staff access.
        </div>
      </div>
      <div style="display:flex; gap:10px;">
        <button type="button" class="btn" onclick="toggleElement('createStaffCard')" style="display:inline-flex; align-items:center; gap:6px;">
          <svg class="svg-icon sm" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          + Add New Staff Member
        </button>
        <a href="/dashboard" class="btn btn-secondary">&larr; Dashboard</a>
      </div>
    </div>

    <!-- Create Staff Form (Collapsible) -->
    <div id="createStaffCard" class="card" style="display:none; background:#F8FAFC; border:1px solid #CBD5E1; margin-bottom:24px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; border-bottom:1px solid #E2E8F0; padding-bottom:10px;">
        <h2 style="margin:0; font-size:1.15rem; color:#0B3D2E;">Create New Staff Account</h2>
        <button type="button" class="btn btn-sm btn-secondary" onclick="toggleElement('createStaffCard')">Close</button>
      </div>

      <form action="/staff" method="POST">
        <div class="grid-2" style="margin-bottom:12px;">
          <div class="form-group">
            <label style="font-size:12px; font-weight:600;">Full Name &amp; Title</label>
            <input type="text" name="name" placeholder="e.g. Dr. Kwame Boateng, OD" required />
          </div>
          <div class="form-group">
            <label style="font-size:12px; font-weight:600;">Email (Login Username)</label>
            <input type="email" name="email" placeholder="e.g. dr.boateng@opticare.local" required />
          </div>
        </div>

        <div class="grid-3" style="margin-bottom:16px;">
          <div class="form-group">
            <label style="font-size:12px; font-weight:600;">System Access Role</label>
            <select name="role" required style="width:100%; padding:10px; border-radius:8px; border:1px solid var(--border); font-size:13px; font-weight:600;">
              <option value="doctor">Optometrist / Doctor</option>
              <option value="receptionist">Receptionist / Cashier</option>
              <option value="admin">Clinic Administrator</option>
            </select>
          </div>
          <div class="form-group">
            <label style="font-size:12px; font-weight:600;">Assigned Consulting Room</label>
            <select name="room" style="width:100%; padding:10px; border-radius:8px; border:1px solid var(--border); font-size:13px;">
              <option value="Consultation Room 1">Consultation Room 1</option>
              <option value="Consultation Room 2">Consultation Room 2</option>
              <option value="Consultation Room 3">Consultation Room 3</option>
              <option value="Reception / Cashier Desk">Reception / Cashier Desk</option>
              <option value="Administration Office">Administration Office</option>
            </select>
          </div>
          <div class="form-group">
            <label style="font-size:12px; font-weight:600;">Initial Password</label>
            <input type="password" name="password" placeholder="••••••••" required />
          </div>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:8px;">
          <button type="submit" class="btn" style="padding:10px 24px; font-weight:700;">+ Save Staff Login</button>
        </div>
      </form>
    </div>

    <!-- Active Staff Accounts Table -->
    <div class="card">
      <h2 style="margin-top:0; color:#0B3D2E; font-size:1.15rem; margin-bottom:16px;">Clinic Staff &amp; Doctor Directory (<%= users.length %>)</h2>

      <div style="overflow-x:auto;">
        <table class="staff-table">
          <thead>
            <tr>
              <th>Staff Member</th>
              <th>Login Email</th>
              <th>Access Role</th>
              <th>Assigned Room / Station</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <tr>
                <td>
                  <div style="display:flex; align-items:center; gap:10px;">
                    <div class="avatar-circle sm <%= u.role === 'doctor' ? 'green' : (u.role === 'admin' ? 'orange' : '') %>">
                      <%= (u.name || u.email).charAt(0).toUpperCase() %>
                    </div>
                    <div>
                      <strong style="color:#0F172A;"><%= u.name || 'Unnamed Staff' %></strong>
                      <% if (u.id === currentUser.id) { %>
                        <span style="font-size:11px; color:#166534; font-weight:700; margin-left:4px;">(You)</span>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td style="color:#334155; font-family:monospace; font-size:13px;"><%= u.email %></td>
                <td>
                  <span class="role-badge role-<%= u.role %>">
                    <%= u.role === 'doctor' ? 'Optometrist' : (u.role === 'admin' ? 'Administrator' : 'Receptionist') %>
                  </span>
                </td>
                <td>
                  <span style="font-size:12.5px; color:#475569; font-weight:600;">
                    <%= u.room || (u.role === 'doctor' ? 'Consultation Room 1' : 'General Station') %>
                  </span>
                </td>
                <td style="text-align:right;">
                  <div style="display:inline-flex; gap:6px; align-items:center;">
                    <!-- Edit Drawer Toggle -->
                    <button type="button" class="btn btn-sm btn-secondary" onclick="toggleElement('editUser_<%= u.id %>')" style="font-size:11px; padding:4px 8px;">
                      Edit / Reset
                    </button>

                    <!-- Delete Form (Cannot delete self) -->
                    <% if (u.id !== currentUser.id) { %>
                      <form action="/staff/<%= u.id %>/delete" method="POST" style="margin:0;" onsubmit="return confirm('Revoke login access for <%= u.name || u.email %>?');">
                        <button type="submit" class="btn btn-sm btn-secondary" style="font-size:11px; padding:4px 7px; color:#B91C1C; border-color:#FECACA;" title="Delete Staff Account">
                          ✕
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>

              <!-- Inline Edit Form Row -->
              <tr id="editUser_<%= u.id %>" style="display:none; background:#F8FAFC;">
                <td colspan="5" style="padding:16px 20px; border-bottom:2px solid #CBD5E1;">
                  <form action="/staff/<%= u.id %>/update" method="POST">
                    <div style="font-weight:700; color:#0B3D2E; font-size:13px; margin-bottom:10px;">
                      Edit Staff Details: <%= u.name || u.email %>
                    </div>
                    <div class="grid-4" style="gap:10px; margin-bottom:10px;">
                      <div class="form-group">
                        <label style="font-size:11px; font-weight:600;">Name &amp; Title</label>
                        <input type="text" name="name" value="<%= u.name || '' %>" required style="font-size:12px; padding:6px 8px;" />
                      </div>
                      <div class="form-group">
                        <label style="font-size:11px; font-weight:600;">Email</label>
                        <input type="email" name="email" value="<%= u.email %>" required style="font-size:12px; padding:6px 8px;" />
                      </div>
                      <div class="form-group">
                        <label style="font-size:11px; font-weight:600;">Role</label>
                        <select name="role" required style="font-size:12px; padding:6px 8px; border-radius:6px; border:1px solid var(--border); width:100%;">
                          <option value="doctor" <%= u.role === 'doctor' ? 'selected' : '' %>>Doctor / Optometrist</option>
                          <option value="receptionist" <%= u.role === 'receptionist' ? 'selected' : '' %>>Receptionist / Cashier</option>
                          <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Administrator</option>
                        </select>
                      </div>
                      <div class="form-group">
                        <label style="font-size:11px; font-weight:600;">Assigned Room</label>
                        <select name="room" style="font-size:12px; padding:6px 8px; border-radius:6px; border:1px solid var(--border); width:100%;">
                          <option value="Consultation Room 1" <%= u.room === 'Consultation Room 1' ? 'selected' : '' %>>Consultation Room 1</option>
                          <option value="Consultation Room 2" <%= u.room === 'Consultation Room 2' ? 'selected' : '' %>>Consultation Room 2</option>
                          <option value="Consultation Room 3" <%= u.room === 'Consultation Room 3' ? 'selected' : '' %>>Consultation Room 3</option>
                          <option value="Reception / Cashier Desk" <%= u.room === 'Reception / Cashier Desk' ? 'selected' : '' %>>Reception / Cashier Desk</option>
                          <option value="Administration Office" <%= u.room === 'Administration Office' ? 'selected' : '' %>>Administration Office</option>
                        </select>
                      </div>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                      <div style="display:flex; gap:8px; align-items:center;">
                        <input type="password" name="new_password" placeholder="New password (leave blank to keep current)" style="font-size:12px; padding:6px 8px; width:280px;" />
                      </div>
                      <div style="display:flex; gap:6px;">
                        <button type="button" class="btn btn-sm btn-secondary" onclick="toggleElement('editUser_<%= u.id %>')">Cancel</button>
                        <button type="submit" class="btn btn-sm" style="background:#166534; font-weight:700;">Save Updates</button>
                      </div>
                    </div>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
</body>
</html>
