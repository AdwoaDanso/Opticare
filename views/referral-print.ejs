<!DOCTYPE html>
<html>
<head>
  <title>Referral Sheet · OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body style="padding:40px;">
  <div class="card" style="max-width:450px;">
    <h2 style="margin-top:0; color:var(--forest);">OptiCare Clinic — Referral Sheet</h2>
    <p><strong>Patient:</strong> <%= patient.full_name %></p>
    <p><strong>Phone:</strong> <%= patient.phone %></p>
    <p><strong>Date:</strong> <%= new Date().toLocaleDateString() %></p>
    <hr />
    <p><strong>Referred To:</strong> <%= referredTo %></p>
    <p><strong>Reason:</strong> <%= reason %></p>
    <button class="btn" onclick="window.print()" style="margin-top:16px;">Print</button>
  </div>
</body>
</html>