<!DOCTYPE html>
<html>
<head>
  <title>OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2220%22 fill=%22%230B3D2E%22/><text x=%2250%22 y=%2265%22 font-size=%2255%22 fill=%22white%22 text-anchor=%22middle%22 font-family=%22Arial%22>O</text></svg>" />
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <div class="page-header">
      <div>
        <h1 style="margin:0;">Patients Directory</h1>
      </div>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <p style="margin:0;">
          <a href="/export/patients" class="btn btn-sm btn-secondary" style="display:inline-flex; align-items:center; gap:6px;">
            <svg class="svg-icon sm" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export CSV
          </a>
        </p>
      <% } %>
    </div>

    <% if (expiringCertificates && expiringCertificates.length > 0 && currentUser && currentUser.role !== 'doctor') { %>
      <div class="card" style="background:#FFF4E5; border-left:4px solid #B8860B;">
        <strong style="display:flex; align-items:center; gap:8px;">
          <svg class="svg-icon" viewBox="0 0 24 24" style="stroke:#B8860B;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          Certificate Renewal Needed
        </strong>
        <% expiringCertificates.forEach(function(cert) { %>
          <p style="margin:4px 0;"><%= cert.name %> (Expires <%= cert.expiry_date %>)</p>
        <% }); %>
        <a href="/certificates">Go to Certificates</a>
      </div>
    <% } %>

    <div class="stats-grid">
      <div class="stat-card dark">
        <div class="value"><%= totalPatients %></div>
        <div class="label">Total Patients</div>
      </div>
      <div class="stat-card">
        <div class="value"><%= waitingCount %></div>
        <div class="label">Currently Waiting</div>
      </div>
      <% if (currentUser && currentUser.role !== 'doctor' && unpaidCount !== null) { %>
        <div class="stat-card">
          <div class="value"><%= unpaidCount %></div>
          <div class="label">Unpaid Invoices</div>
        </div>
      <% } %>
    </div>

    <!-- Registration Confirmation Alert -->
    <% if (typeof registeredName !== 'undefined' && registeredName) { %>
      <div class="card" style="background:#F0FDF4; border:1px solid #BBF7D0; border-left:4px solid #166534; padding:16px 20px; margin-bottom:18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
          <div style="font-size:14.5px; font-weight:700; color:#166534; display:flex; align-items:center; gap:8px;">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#166534" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Patient <%= registeredName %> Registered Successfully!
          </div>
          <div style="font-size:13px; color:#14532D; margin-top:2px;">
            Patient ID: <strong>#<%= registeredId %></strong> · Saved to directory. Ready for queue check-in or clinical intake.
          </div>
        </div>
        <div style="display:flex; gap:10px; align-items:center;">
          <form action="/queue/checkin/<%= registeredId %>" method="POST" style="margin:0;">
            <button type="submit" class="btn btn-sm" style="background:#166534; font-weight:700; padding:8px 16px;">
              Check In to Live Queue &rarr;
            </button>
          </form>
          <a href="/patients/<%= registeredId %>" class="btn btn-sm btn-secondary">Open Profile</a>
        </div>
      </div>
    <% } %>

    <!-- Queue Check-In Confirmation Alert -->
    <% if (typeof checkedInName !== 'undefined' && checkedInName) { %>
      <div class="card" style="background:#EFF6FF; border:1px solid #BFDBFE; border-left:4px solid #2563EB; padding:14px 20px; margin-bottom:18px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
          <div style="font-size:14px; font-weight:700; color:#1E40AF; display:flex; align-items:center; gap:8px;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#2563EB" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            ✓ <%= checkedInName %> Checked into Waiting Queue!
          </div>
          <div style="font-size:12.5px; color:#1E3A8A; margin-top:2px;">
            Current Queue Position: <strong>#<%= typeof queuePos !== 'undefined' && queuePos ? queuePos : waitingCount %></strong> · Attending doctors have been notified.
          </div>
        </div>
        <div>
          <a href="/queue" class="btn btn-sm" style="background:#2563EB; font-weight:700;">View Live Queue &rarr;</a>
        </div>
      </div>
    <% } %>

    <!-- Register Patient Form -->
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <h2 style="margin:0; color:#0B3D2E;">Register New Patient</h2>
      </div>

      <% if (typeof duplicateWarning !== 'undefined' && duplicateWarning) { %>
        <div class="card" style="background:#FFF4E5; border-left:4px solid #B8860B; margin-bottom:16px;">
          <strong style="display:flex; align-items:center; gap:8px;">
            <svg class="svg-icon" viewBox="0 0 24 24" style="stroke:#B8860B;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Possible duplicate detected:
          </strong>
          A patient named <strong><%= duplicateWarning.full_name %></strong> (<%= duplicateWarning.phone %>) already exists.
          <a href="/patients/<%= duplicateWarning.id %>" style="margin-left:6px; font-weight:600;">View existing record</a>
          <form action="/patients" method="POST" style="margin-top:8px;">
            <input type="hidden" name="full_name" value="<%= pendingFullName %>" />
            <input type="hidden" name="phone" value="<%= pendingPhone %>" />
            <input type="hidden" name="confirm_duplicate" value="1" />
            <button type="submit" class="btn btn-sm btn-secondary">Create new patient anyway</button>
          </form>
        </div>
      <% } %>

      <form action="/patients" method="POST">
        <div class="form-row" style="margin-bottom:10px;">
          <div class="form-group" style="flex:2;">
            <label style="font-size:12px; font-weight:600;">Full Legal Name *</label>
            <input type="text" name="full_name" placeholder="e.g. Ama Osei" required />
          </div>
          <div class="form-group" style="flex:1;">
            <label style="font-size:12px; font-weight:600;">Phone Number</label>
            <input type="text" name="phone" placeholder="e.g. 0241234567" />
          </div>
          <div class="form-group" style="flex:1;">
            <label style="font-size:12px; font-weight:600;">Email (Optional)</label>
            <input type="email" name="email" placeholder="patient@example.com" />
          </div>
        </div>

        <div class="form-row" style="margin-bottom:12px;">
          <div class="form-group" style="flex:2;">
            <label style="font-size:12px; font-weight:600;">Residential Address / Location</label>
            <input type="text" name="address" placeholder="e.g. East Legon, Accra / House No. 12, Kumasi" />
          </div>
          <div class="form-group" style="flex:1;">
            <label style="font-size:12px; font-weight:600;">Gender</label>
            <select name="gender" style="width:100%; padding:10px; border-radius:10px; border:1px solid var(--border);">
              <option value="">Select Gender</option>
              <option value="Male">Male</option>
              <option value="Female">Female</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="form-group" style="flex:1;">
            <label style="font-size:12px; font-weight:600;">Age</label>
            <input type="number" name="age" placeholder="e.g. 35" />
          </div>
        </div>

        <div class="form-row" style="margin-bottom:14px;">
          <div class="form-group" style="flex:1;">
            <label style="font-size:12px; font-weight:600;">Occupation / Visual Demands</label>
            <input type="text" name="occupation" placeholder="e.g. Accountant, Driver, Student" />
          </div>
          <div class="form-group" style="flex:1;">
            <label style="font-size:12px; font-weight:600;">Emergency Contact Name</label>
            <input type="text" name="emergency_contact_name" placeholder="e.g. Kofi Mensah (Brother)" />
          </div>
          <div class="form-group" style="flex:1;">
            <label style="font-size:12px; font-weight:600;">Emergency Contact Phone</label>
            <input type="text" name="emergency_contact_phone" placeholder="e.g. 0244001122" />
          </div>
        </div>

        <button type="submit" class="btn" style="padding:10px 24px; font-weight:700; background:#166534;">Register Patient</button>
      </form>
    </div>

    <!-- Search & Patients List -->
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:10px;">
        <h2 style="margin:0; color:#0B3D2E;">Patient Directory (<%= patients.length %>)</h2>
        <form action="/" method="GET" style="display:flex; gap:8px; margin:0; align-items:center;">
          <input 
            type="text" 
            id="patientSearchInput"
            name="q" 
            value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>" 
            placeholder="Search by name, ID (#), phone, email..." 
            oninput="filterPatientsLive(this.value)"
            style="padding:8px 12px; border-radius:8px; border:1px solid var(--border); font-size:13px; min-width:260px;" 
          />
          <button type="submit" class="btn btn-sm btn-secondary">Search</button>
          <% if (typeof searchTerm !== 'undefined' && searchTerm) { %>
            <a href="/" class="btn btn-sm btn-secondary" title="Clear search filter">✕ Clear</a>
          <% } %>
        </form>
      </div>

      <div id="patientListContainer">
        <% if (patients.length === 0) { %>
          <div class="empty-state">No patients found matching your search.</div>
        <% } else { %>
          <% patients.forEach(function(patient) { %>
            <div class="list-row patient-card-row" data-search="<%= (patient.full_name + ' #' + patient.id + ' ' + (patient.phone || '') + ' ' + (patient.email || '') + ' ' + (patient.address || '')).toLowerCase() %>" style="align-items:center;">
              <div style="display:flex; align-items:center; gap:12px;">
                <div class="avatar-circle sm green"><%= patient.full_name.charAt(0).toUpperCase() %></div>
                <div>
                  <div class="name"><a href="/patients/<%= patient.id %>" style="font-weight:700;"><%= patient.full_name %></a></div>
                  <div class="meta">
                    ID: #<%= patient.id %> | <%= patient.phone || 'No phone on file' %>
                    <% if (patient.email) { %> | <%= patient.email %><% } %>
                    <% if (patient.address) { %> | <%= patient.address %><% } %>
                    <% if (patient.gender || patient.age) { %> | <%= patient.gender || '' %> <%= patient.age ? '(' + patient.age + ' yrs)' : '' %><% } %>
                    <% if (patient.occupation) { %> | <%= patient.occupation %><% } %>
                  </div>
                </div>
              </div>
              <div style="display:flex; gap:8px; align-items:center;">
                <form action="/queue/checkin/<%= patient.id %>" method="POST" style="margin:0;">
                  <button type="submit" class="btn btn-sm btn-secondary" title="Check in to waiting queue">Check In</button>
                </form>
                <a href="/patients/<%= patient.id %>" class="btn btn-sm">Open Profile &rarr;</a>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Live Client-side Search Filter Script -->
    <script>
      function filterPatientsLive(query) {
        const q = (query || '').toLowerCase().trim().replace(/^#/, '');
        const rows = document.querySelectorAll('.patient-card-row');
        let matches = 0;
        rows.forEach(row => {
          const text = row.getAttribute('data-search') || '';
          if (!q || text.includes(q)) {
            row.style.display = 'flex';
            matches++;
          } else {
            row.style.display = 'none';
          }
        });
      }
    </script>

  </div>
</div>
</body>
</html>