<!DOCTYPE html>
<html>
<head>
  <title>Queue · OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <div class="page-header">
      <h1>Patient Queue</h1>
      <div class="subtitle">Who's waiting and who's in consultation</div>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">Now In Consultation</h2>
      <% if (inConsultation.length === 0) { %>
        <div class="empty-state">No one is currently with a doctor.</div>
      <% } else { %>
        <% inConsultation.forEach(function(entry) { %>
          <div class="list-row">
            <div>
              <div class="name"><%= entry.full_name %></div>
              <div class="meta"><%= entry.room %></div>
            </div>
            <form action="/queue/<%= entry.id %>/complete" method="POST">
              <button type="submit" class="btn btn-sm btn-secondary">Mark Done</button>
            </form>
          </div>
        <% }); %>
      <% } %>
    </div>

    <div class="card">
      <h2 style="margin-top:0;">Waiting</h2>
      <% if (waiting.length === 0) { %>
        <div class="empty-state">No one is currently waiting.</div>
      <% } else { %>
        <% waiting.forEach(function(entry) { %>
          <div class="list-row">
            <div class="name"><%= entry.full_name %></div>
            <span class="badge badge-danger">waiting</span>
          </div>
        <% }); %>
      <% } %>
    </div>

    <a href="/">&larr; Back to patient list</a>
  </div>
</div>
</body>
</html>