<!DOCTYPE html>
<html>
<head>
  <title>Live Patient Queue | OptiCare</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2220%22 fill=%22%230B3D2E%22/><text x=%2250%22 y=%2265%22 font-size=%2255%22 fill=%22white%22 text-anchor=%22middle%22 font-family=%22Arial%22>O</text></svg>" />
</head>
<body>
<div class="layout">
  <%- include('partials/sidebar') %>
  <div class="main">
    <div class="page-header">
      <div>
        <h1 style="margin:0 0 4px;">Live Clinic Queue</h1>
      </div>
      <a href="/" class="btn btn-secondary">&larr; Back to Patients Directory</a>
    </div>

    <!-- Finalised Examination Confirmation Alert -->
    <% if (typeof finalisedName !== 'undefined' && finalisedName) { %>
      <div class="card" style="background:#F0FDF4; border:1px solid #BBF7D0; border-left:4px solid #166534; padding:16px 20px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
          <div style="font-size:14.5px; font-weight:700; color:#166534; display:flex; align-items:center; gap:8px;">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#166534" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            ✓ Examination for <%= finalisedName %> Saved &amp; Discharged to Billing!
          </div>
          <div style="font-size:13px; color:#14532D; margin-top:2px;">
            Patient ID: <strong>#<%= finalisedId %></strong> · Patient transferred to Cashier &amp; Pharmacy counter. Ready to attend to the next waiting patient below.
          </div>
        </div>
        <div>
          <a href="/patients/<%= finalisedId %>" class="btn btn-sm btn-secondary">Review Chart</a>
        </div>
      </div>
    <% } %>

    <!-- Section 1: Ready for Payment & Drug Collection (Cashier & Pharmacy) -->
    <div class="card" style="border-left:4px solid #166534; background:#F8FAFC; margin-bottom:20px;">
      <div class="page-header" style="margin-bottom:12px;">
        <div>
          <h2 style="margin:0; color:#0B3D2E; display:flex; align-items:center; gap:8px;">
            <svg class="svg-icon" viewBox="0 0 24 24" style="stroke:#166534;"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            Cashier &amp; Pharmacy Counter (<%= readyForBilling ? readyForBilling.length : 0 %>)
          </h2>
        </div>
      </div>

      <% if (!readyForBilling || readyForBilling.length === 0) { %>
        <div class="empty-state" style="padding:16px;">No patients currently waiting at the cashier desk.</div>
      <% } else { %>
        <% readyForBilling.forEach(function(entry) { %>
          <div class="list-row" style="background:#fff; border:1px solid #E2E8F0; border-radius:10px; margin-bottom:8px; padding:12px 16px; align-items:center;">
            <div style="flex:2;">
              <div style="display:flex; align-items:center; gap:8px;">
                <span class="avatar-circle sm green"><%= entry.full_name.charAt(0).toUpperCase() %></span>
                <div>
                  <span class="name" style="font-weight:700; font-size:14px;"><%= entry.full_name %></span>
                  <span style="font-size:12px; color:#64748B; margin-left:6px;">#<%= entry.patient_id %> | <%= entry.phone || 'No phone on file' %></span>
                </div>
              </div>
              <div class="meta" style="margin-top:4px;">
                <% if (entry.drug_count > 0) { %>
                  <span class="badge badge-success" style="font-size:10.5px; padding:2px 6px; display:inline-flex; align-items:center; gap:4px;">
                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                    <%= entry.drug_count %> Medication(s) Prescribed
                  </span>
                <% } else { %>
                  <span class="badge" style="font-size:10.5px; padding:2px 6px; background:#E0E7FF; color:#3730A3; display:inline-flex; align-items:center; gap:4px;">
                    <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                    Consultation Complete
                  </span>
                <% } %>
                <span style="margin-left:8px; color:#64748B;">Discharged at: <%= entry.checked_in_at %></span>
              </div>
            </div>

            <div style="text-align:right; margin-right:16px;">
              <div style="font-size:11px; text-transform:uppercase; color:#64748B; font-weight:700;">Balance Due</div>
              <div style="font-size:1.15rem; font-weight:800; color:#B91C1C;">
                GHS <%= Number(entry.unpaid_total).toFixed(2) %>
              </div>
            </div>

            <div style="display:flex; gap:8px;">
              <a href="/patients/<%= entry.patient_id %>?tab=billing" class="btn btn-sm" style="padding:8px 14px; background:#22A366; font-weight:700; display:inline-flex; align-items:center; gap:6px;">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                Open POS &amp; Collect Payment &rarr;
              </a>
              <form action="/queue/<%= entry.id %>/complete" method="POST" style="margin:0;">
                <button type="submit" class="btn btn-sm btn-secondary" title="Discharge patient">Discharge</button>
              </form>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Section 2: In Doctor's Consultation -->
    <div class="card" style="margin-bottom:20px;">
      <h2 style="margin-top:0; color:#0B3D2E;">Active Doctor Consultations (<%= inConsultation.length %>)</h2>
      <% if (inConsultation.length === 0) { %>
        <div class="empty-state">No one is currently inside a consultation room.</div>
      <% } else { %>
        <% inConsultation.forEach(function(entry) { %>
          <div class="list-row">
            <div>
              <div class="name"><a href="/patients/<%= entry.patient_id %>" style="font-weight:700;"><%= entry.full_name %></a></div>
              <div class="meta"><%= entry.room || 'Consultation Room' %> <%= entry.doctor_name ? '· Attending: ' + entry.doctor_name : '' %> | <a href="/patients/<%= entry.patient_id %>">Open Patient Clinical Chart &rarr;</a></div>
            </div>
            <form action="/queue/<%= entry.id %>/complete" method="POST" style="margin:0;">
              <button type="submit" class="btn btn-sm btn-secondary">Mark Consultation Complete</button>
            </form>
          </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Section 3: Waiting Room (To see Doctor) -->
    <div class="card">
      <h2 style="margin-top:0; color:#0B3D2E;">Waiting Room (<%= waiting.length %>)</h2>
      <% if (waiting.length === 0) { %>
        <div class="empty-state">No patients currently waiting in queue.</div>
      <% } else { %>
        <% waiting.forEach(function(entry) { %>
          <div class="list-row" style="align-items:center;">
            <div>
              <div class="name"><a href="/patients/<%= entry.patient_id %>" style="font-weight:700;"><%= entry.full_name %></a></div>
              <div class="meta">Checked in at: <%= entry.checked_in_at %></div>
            </div>
            <div style="display:flex; align-items:center; gap:10px;">
              <span class="badge badge-danger">WAITING</span>
              <% if (currentUser && (currentUser.role === 'doctor' || currentUser.role === 'admin')) { %>
                <form action="/queue/<%= entry.id %>/call" method="POST" style="display:flex; gap:6px; margin:0;">
                  <select name="room" style="padding:6px 8px; border-radius:8px; border:1px solid var(--border); font-size:12px; font-weight:600;">
                    <option value="Consultation Room 1" <%= (currentUser.room === 'Consultation Room 1') ? 'selected' : '' %>>Room 1</option>
                    <option value="Consultation Room 2" <%= (currentUser.room === 'Consultation Room 2') ? 'selected' : '' %>>Room 2</option>
                    <option value="Consultation Room 3" <%= (currentUser.room === 'Consultation Room 3') ? 'selected' : '' %>>Room 3</option>
                  </select>
                  <button type="submit" class="btn btn-sm" style="display:inline-flex; align-items:center; gap:5px; background:#166534;">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    Call In &amp; Open Profile
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>

  </div>
</div>
</body>
</html>