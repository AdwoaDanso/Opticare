<div class="sidebar" id="appSidebar">
  <!-- Brand / Logo Area -->
  <div class="brand">
    <div class="brand-logo-icon">
      <% if (typeof clinicSettings !== 'undefined' && clinicSettings.clinic_logo) { %>
        <img src="/uploads/<%= clinicSettings.clinic_logo %>" alt="Logo" class="clinic-logo-img" />
      <% } else { %>
        <svg class="svg-icon lg brand-svg" viewBox="0 0 24 24" style="stroke:#22A366;"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
      <% } %>
    </div>
    <span class="brand-text">
      <%= (typeof clinicSettings !== 'undefined' && clinicSettings.clinic_name) ? clinicSettings.clinic_name.split(' ')[0] : 'OptiCare' %>
    </span>
    
    <!-- Pin / Expand Toggle Icon -->
    <button type="button" class="sidebar-pin-btn" id="sidebarPinBtn" title="Pin / Unpin Sidebar">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
  </div>

  <!-- Navigation Links -->
  <nav class="sidebar-nav">
    <a href="/dashboard" class="nav-item <%= currentPath.startsWith('/dashboard') ? 'active' : '' %>" data-tooltip="Dashboard">
      <span class="nav-icon">
        <svg class="svg-icon sm" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      </span>
      <span class="nav-label">Dashboard</span>
    </a>

    <a href="/" class="nav-item <%= (currentPath === '/' || currentPath.startsWith('/patients')) ? 'active' : '' %>" data-tooltip="Patients">
      <span class="nav-icon">
        <svg class="svg-icon sm" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <span class="nav-label">Patients</span>
    </a>

    <a href="/queue" class="nav-item <%= currentPath.startsWith('/queue') ? 'active' : '' %>" data-tooltip="Live Queue">
      <span class="nav-icon">
        <svg class="svg-icon sm" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </span>
      <span class="nav-label">Live Queue</span>
    </a>

    <a href="/appointments" class="nav-item <%= currentPath.startsWith('/appointments') || currentPath.startsWith('/recall') ? 'active' : '' %>" data-tooltip="Appointments">
      <span class="nav-icon">
        <svg class="svg-icon sm" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      </span>
      <span class="nav-label">Appointments</span>
    </a>

    <a href="/inventory" class="nav-item <%= currentPath.startsWith('/inventory') ? 'active' : '' %>" data-tooltip="Inventory">
      <span class="nav-icon">
        <svg class="svg-icon sm" viewBox="0 0 24 24"><path d="M21 8V21H3V8"/><path d="M1 3h22v5H1z"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
      </span>
      <span class="nav-label">Inventory</span>
    </a>

    <% if (currentUser && currentUser.role === 'admin') { %>
      <a href="/report" class="nav-item <%= currentPath.startsWith('/report') ? 'active' : '' %>" data-tooltip="Reports">
        <span class="nav-icon">
          <svg class="svg-icon sm" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        </span>
        <span class="nav-label">Reports</span>
      </a>

      <a href="/certificates" class="nav-item <%= currentPath.startsWith('/certificates') ? 'active' : '' %>" data-tooltip="Certificates">
        <span class="nav-icon">
          <svg class="svg-icon sm" viewBox="0 0 24 24"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
        </span>
        <span class="nav-label">Certificates</span>
      </a>

      <a href="/settings" class="nav-item <%= currentPath.startsWith('/settings') ? 'active' : '' %>" data-tooltip="Settings">
        <span class="nav-icon">
          <svg class="svg-icon sm" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </span>
        <span class="nav-label">Settings</span>
      </a>
    <% } %>
  </nav>

  <!-- User Profile & Logout Bottom Area -->
  <% if (currentUser) { %>
    <div class="sidebar-user">
      <div class="sidebar-user-avatar">
        <%= currentUser.email.charAt(0).toUpperCase() %>
      </div>
      <div class="sidebar-user-details">
        <div class="sidebar-user-email" title="<%= currentUser.email %>"><%= currentUser.email %></div>
        <div class="sidebar-user-role"><%= currentUser.role %></div>
        <form action="/logout" method="POST" style="margin-top:6px;">
          <button type="submit" class="sidebar-logout-btn">Log Out</button>
        </form>
      </div>
    </div>
  <% } %>
</div>

<!-- Inline Interactive Script for Pin / Unpin Sidebar Preference -->
<script>
  (function() {
    const sidebar = document.getElementById('appSidebar');
    const pinBtn = document.getElementById('sidebarPinBtn');
    if (!sidebar || !pinBtn) return;

    // Check localStorage preference
    const isPinned = localStorage.getItem('opticare_sidebar_pinned') === 'true';
    if (isPinned) {
      sidebar.classList.add('is-pinned');
    }

    pinBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      sidebar.classList.toggle('is-pinned');
      const pinned = sidebar.classList.contains('is-pinned');
      localStorage.setItem('opticare_sidebar_pinned', pinned);
    });
  })();
</script>