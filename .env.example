# OptiCare Eye Clinic - Environment Configuration

PORT=3000
SESSION_SECRET=opticare-super-secure-session-key-2026

# SMS Gateway Configuration (Ghanaian Providers)
# Set your preferred provider's API key below. The system will automatically detect and use it.

# Option 1: Arkesel (Recommended for Ghana)
# ARKESEL_API_KEY=your_arkesel_api_key_here

# Option 2: mNotify (Ghana)
# MNOTIFY_API_KEY=your_mnotify_api_key_here

# Option 3: Hubtel (Ghana)
# HUBTEL_CLIENT_ID=your_hubtel_client_id_here
# HUBTEL_CLIENT_SECRET=your_hubtel_client_secret_here

# Sender ID (Max 11 alphanumeric characters)
SMS_SENDER_ID=OptiCare

# -------------------------------------------------------------
# Mobile Money (MoMo) Payment Gateway Configuration (Ghana)
# -------------------------------------------------------------
# Option A: Paystack Ghana (Supports MTN MoMo, Telecel Cash, AT Money, Cards)
# PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
# PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Option B: Hubtel Direct MoMo Merchant API
# HUBTEL_MERCHANT_ACCOUNT_NUMBER=your_hubtel_momo_account_number

